# Local Spring Boot environment (do not commit real values)
SPRING_PROFILES_ACTIVE=default
MYSQL_URL=jdbc:mysql://127.0.0.1:3306/sprintdesk?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
MYSQL_USERNAME=your_mysql_user
MYSQL_PASSWORD=your_mysql_password
MONGODB_URI=mongodb://127.0.0.1:27017/sprintdesk
JWT_SECRET=replace-with-a-long-random-secret
CORS_ALLOWED_ORIGINS=http://localhost:5173
PORT=8080
