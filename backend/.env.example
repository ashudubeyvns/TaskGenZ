# TaskGenZ Backend - Local / Production Environment Template

# MySQL
MYSQL_URL=jdbc:mysql://127.0.0.1:3306/taskgenz?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
MYSQL_USERNAME=your_mysql_user
MYSQL_PASSWORD=your_mysql_password

# MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/taskgenz

# JWT
JWT_SECRET=replace-with-a-long-random-secret

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Server
PORT=8080
SPRING_PROFILES_ACTIVE=default
